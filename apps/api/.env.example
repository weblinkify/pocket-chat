# Provider: mock | openai | anthropic
LLM_PROVIDER=mock

# Mock provider tuning
MOCK_LATENCY_MS=30
MOCK_CHUNK_SIZE=4
MOCK_SEED=42

# Real providers (only read when LLM_PROVIDER is set to them)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# HTTP
CORS_ORIGINS=*
RATE_LIMIT=60/minute
LOG_LEVEL=info
